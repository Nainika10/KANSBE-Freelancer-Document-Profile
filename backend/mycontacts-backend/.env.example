# ---------------------------------------------------------------------------
# KANSBE backend environment template
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

PORT=5001

# MongoDB connection string. The database name is the path segment before "?"
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/kansbe_demo
CONNECTION_STRING=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE

# JWT secrets — generate four different random values.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ADMIN_ACCESS_TOKEN_SECRET=change-me
ADMIN_REFRESH_TOKEN_SECRET=change-me

# Python docgen service
# PYTHON_API_KEY must be identical to the one in the docgen service .env
PYTHON_API_KEY=change-me
PYTHON_API_URL=http://127.0.0.1:8002

# Optional — AWS (S3 document upload, SES email)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
SES_VERIFIED_EMAIL=

# Optional — Google sign-in
GOOGLE_CLIENT_ID=

# Optional — Redis (background email worker / queues)
# REDIS_URL=redis://127.0.0.1:6379
